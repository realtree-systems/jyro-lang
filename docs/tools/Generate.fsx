// Generates the standard library pages and the error code table of the
// jyro-doc manual from the built assemblies and the XML documentation.
//
//   dotnet build -c Release src/Jyro.Api/Jyro.Api.fsproj
//   dotnet fsi docs/tools/Generate.fsx
//
// A page whose first line is `<!-- hand-written -->` is never written or
// deleted. Every other .md file in a category folder is replaced.

#r "nuget: FParsec, 1.1.1"
#r "../../src/Jyro.Api/bin/Release/net8.0/Jyro.Core.dll"
#r "../../src/Jyro.Api/bin/Release/net8.0/Jyro.Parser.dll"
#r "../../src/Jyro.Api/bin/Release/net8.0/Jyro.Compiler.dll"
#r "../../src/Jyro.Api/bin/Release/net8.0/Jyro.Stdlib.dll"
#r "../../src/Jyro.Api/bin/Release/net8.0/Jyro.Api.dll"

open System
open System.IO
open System.Text
open System.Xml.Linq
open RealTree.Jyro

let bin = Path.GetFullPath(Path.Combine(__SOURCE_DIRECTORY__, "..", "..", "src", "Jyro.Api", "bin", "Release", "net8.0"))
// The manual lives in the jyro-doc repository: a sibling of this one, or the
// root named by the JYRO_DOC environment variable.
let manual =
    match Environment.GetEnvironmentVariable "JYRO_DOC" with
    | null | "" -> Path.GetFullPath(Path.Combine(__SOURCE_DIRECTORY__, "..", "..", "..", "jyro-doc", "manual"))
    | root -> Path.Combine(root, "manual")
let stdlibRoot = Path.Combine(manual, "30 Standard Library")

let handWritten = "<!-- hand-written -->"
let generated = "<!-- generated by docs/tools/Generate.fsx; do not edit -->"

let isHandWritten (path: string) =
    File.Exists path && (File.ReadLines path |> Seq.tryHead) = Some handWritten

let write (path: string) (body: string) =
    if isHandWritten path then failwithf "%s is hand-written and in the way of a generated page" path
    Directory.CreateDirectory(Path.GetDirectoryName path) |> ignore
    File.WriteAllText(path, generated + "\n" + body, UTF8Encoding(false))

// --- XML ---------------------------------------------------------------

let xml = XDocument.Load(Path.Combine(bin, "Jyro.Stdlib.xml"))
let members =
    xml.Root.Element("members").Elements("member")
    |> Seq.map (fun m -> m.Attribute("name").Value, m)
    |> dict

/// The text of an element as markdown: `<c>` becomes a code span and every
/// other node is its text.
let rec inline' (node: XNode) : string =
    match node with
    | :? XText as t -> t.Value
    | :? XElement as e when e.Name.LocalName = "c" -> "`" + e.Value + "`"
    | :? XElement as e -> e.Nodes() |> Seq.map inline' |> String.concat ""
    | _ -> ""

let text (e: XElement) : string =
    e.Nodes() |> Seq.map inline' |> String.concat "" |> fun s -> s.Trim()

/// The clauses of an example, split at `; ` outside code spans, each a
/// sentence on its own.
let clauses (s: string) : string list =
    let parts = ResizeArray<string>()
    let current = StringBuilder()
    let mutable inCode = false
    let mutable i = 0
    while i < s.Length do
        let c = s.[i]
        if c = '`' then inCode <- not inCode
        if not inCode && c = ';' && i + 1 < s.Length && s.[i + 1] = ' ' then
            parts.Add(current.ToString().Trim())
            current.Clear() |> ignore
            i <- i + 2
        else
            current.Append(c) |> ignore
            i <- i + 1
    if current.Length > 0 then parts.Add(current.ToString().Trim())
    parts
    |> Seq.map (fun p -> if p.EndsWith(".") then p else p + ".")
    |> Seq.map (fun p -> if p.StartsWith("`") then p else string (Char.ToUpperInvariant p.[0]) + p.Substring(1))
    |> List.ofSeq

// --- Functions ---------------------------------------------------------

let categories =
    [ "StringFunctions", ("20 String", "String")
      "ArrayFunctions", ("30 Array", "Array")
      "MathFunctions", ("40 Math", "Math")
      "DateTimeFunctions", ("50 Date and Time", "Date and Time")
      "UtilityFunctions", ("60 Utility", "Utility")
      "SchemaFunctions", ("70 Schema", "Schema")
      "QueryFunctions", ("80 Query", "Query")
      "LambdaFunctions", ("90 Lambda", "Lambda") ]
    |> dict

let typeName (t: ParameterType) =
    match t with
    | ParameterType.Any -> "any"
    | t -> (string t).ToLowerInvariant()

let effectName (e: FunctionEffect) =
    match e with
    | FunctionEffect.Pure -> "pure"
    | FunctionEffect.NonDeterministic -> "non-deterministic"
    | FunctionEffect.Blocking -> "blocking"
    | FunctionEffect.Mutating -> "mutating"
    | _ -> string e

let slug (s: string) =
    Text.RegularExpressions.Regex.Replace(s.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-')

let functionPage (fn: IJyroFunction) (m: XElement) : string =
    let b = StringBuilder()
    let line (s: string) = b.Append(s).Append('\n') |> ignore
    let signature =
        fn.Signature.Parameters
        |> Seq.map (fun p -> if p.IsOptional then "[" + p.Name + "]" else p.Name)
        |> String.concat ", "
    line ("# " + fn.Name)
    line ""
    line (text (m.Element("summary")))
    line ""
    line "## Signature"
    line ""
    line "```jyro"
    line "# fragment"
    line (sprintf "%s(%s)" fn.Name signature)
    line "```"
    line ""
    if fn.Signature.Parameters.Count > 0 then
        line "| Parameter | Type | Description |"
        line "| --- | --- | --- |"
        let args = m.Elements("arg") |> Seq.map (fun a -> a.Attribute("name").Value, text a) |> dict
        for p in fn.Signature.Parameters do
            let t = typeName p.Type + (if p.IsOptional then ", optional" else "")
            let d = match args.TryGetValue p.Name with | true, d -> d | _ -> ""
            line (sprintf "| `%s` | %s | %s |" p.Name t (d.Replace("|", "\\|")))
        line ""
    line "## Returns"
    line ""
    let returnType = typeName fn.Signature.ReturnType
    let returns = text (m.Element("returns"))
    if returns.StartsWith(returnType, StringComparison.OrdinalIgnoreCase) then line returns
    else line (sprintf "%s. %s" (string (Char.ToUpperInvariant returnType.[0]) + returnType.Substring(1)) returns)
    line ""
    match m.Element("remarks") with
    | null -> ()
    | r ->
        line "## Remarks"
        line ""
        line (text r)
        line ""
    match m.Element("example") with
    | null -> ()
    | e ->
        line "## Example"
        line ""
        for c in clauses (text e) do
            line c
            line ""
    if fn.Effect <> FunctionEffect.Pure then
        line (sprintf "Effect: %s. See [Function Effects](/docs/language/functions/function-effects)." (effectName fn.Effect))
        line ""
    b.ToString().TrimEnd('\n') + "\n"

let functions = StdlibRegistry.getAll () |> List.ofSeq
let byCategory =
    functions
    |> List.groupBy (fun f -> f.GetType().DeclaringType.Name)

let mutable written = ResizeArray<string>()
let mutable warnings = ResizeArray<string>()

for (moduleName, fns) in byCategory do
    let folderName, title = categories.[moduleName]
    let folder = Path.Combine(stdlibRoot, folderName)
    let overview = StringBuilder()
    overview.Append(sprintf "# %s Functions\n\n" title) |> ignore
    overview.Append("| Function | Description |\n| --- | --- |\n") |> ignore
    fns |> List.iteri (fun i fn ->
        let key = "T:" + fn.GetType().FullName.Replace('+', '.')
        let m =
            match members.TryGetValue key with
            | true, m -> m
            | _ -> failwithf "%s has no XML documentation member %s" fn.Name key
        if isNull (m.Element("example")) then warnings.Add(sprintf "%s has no <example>" fn.Name)
        let path = Path.Combine(folder, sprintf "%d %s.md" (20 + 10 * i) fn.Name)
        write path (functionPage fn m)
        written.Add path
        overview.Append(sprintf "| [%s](/docs/standard-library/%s/%s) | %s |\n" fn.Name (slug title) (slug fn.Name) (text (m.Element("summary")))) |> ignore)
    let overviewPath = Path.Combine(folder, "10 Overview.md")
    write overviewPath (overview.ToString())
    written.Add overviewPath
    // Remove stale generated pages.
    for stale in Directory.GetFiles(folder, "*.md") do
        if not (written.Contains stale) && not (isHandWritten stale) then
            File.Delete stale
            printfn "deleted %s" stale

printfn "%d functions in %d categories" functions.Length byCategory.Length

// --- Error codes -------------------------------------------------------

let codes =
    Enum.GetValues(typeof<MessageCode>)
    |> Seq.cast<MessageCode>
    |> Seq.distinct
    |> Seq.sortBy int
    |> List.ofSeq

let bandName (code: int) =
    match code / 1000 with
    | 1 -> "Lexer"
    | 2 -> "Parser"
    | 3 -> "Validator"
    | 4 -> "Linker"
    | 5 -> "Runtime"
    | 6 -> "Compiler"
    | 7 -> "Artifact"
    | _ -> "Other"

let errorPage =
    let b = StringBuilder()
    let line (s: string) = b.Append(s).Append('\n') |> ignore
    line "# Error Codes"
    line ""
    line "Every diagnostic code, with its name and the template of its message. A placeholder such as `{0}` is replaced by the diagnostic's arguments when the message is rendered. Codes are grouped by the part of the system that reports them; see [Diagnostics](/docs/language/errors-and-limits/diagnostics)."
    line ""
    for (band, inBand) in codes |> List.groupBy (fun c -> int c / 1000) do
        line (sprintf "## %s (JM%d000 to JM%d999)" (bandName (band * 1000)) band band)
        line ""
        line "| Code | Name | Message |"
        line "| --- | --- | --- |"
        for c in inBand do
            let template = MessageTemplates.Get(c).Replace("|", "\\|")
            line (sprintf "| JM%d | `%s` | %s |" (int c) (string c) template)
        line ""
    b.ToString().TrimEnd('\n') + "\n"

write (Path.Combine(manual, "20 Language", "100 Errors and Limits", "40 Error Codes.md")) errorPage
printfn "%d error codes" codes.Length

for w in warnings do printfn "warning: %s" w

// --- The catalog inside the LLM guide -------------------------------

/// `jyro-for-llms.md` at the root of jyro-doc carries the whole standard
/// library between two markers, so an LLM reads exact signatures. The text
/// between the markers is replaced; the rest of the file is kept.
let llmGuide = Path.Combine(Path.GetDirectoryName manual, "jyro-for-llms.md")
let startMarker = "<!-- stdlib-catalog:start -->"
let endMarker = "<!-- stdlib-catalog:end -->"

let catalog =
    let b = StringBuilder()
    let line (s: string) = b.Append(s).Append('\n') |> ignore
    line startMarker
    line "<!-- generated by docs/tools/Generate.fsx in the jyro repository; do not edit by hand -->"
    for (moduleName, fns) in byCategory do
        let _, title = categories.[moduleName]
        line ""
        line (sprintf "### %s functions" title)
        line ""
        for fn in fns do
            let m = members.["T:" + fn.GetType().FullName.Replace('+', '.')]
            let signature =
                fn.Signature.Parameters
                |> Seq.map (fun p -> (if p.IsOptional then "[" + p.Name + "]" else p.Name) + ": " + typeName p.Type)
                |> String.concat ", "
            line (sprintf "- **`%s(%s)` -> %s**. %s" fn.Name signature (typeName fn.Signature.ReturnType) (text (m.Element("summary"))))
            line (sprintf "  Returns: %s" (text (m.Element("returns"))))
            match m.Element("example") with
            | null -> ()
            | e -> line (sprintf "  Example: %s" (text e))
            if fn.Effect <> FunctionEffect.Pure then line (sprintf "  Effect: %s." (effectName fn.Effect))
    line endMarker
    b.ToString()

if File.Exists llmGuide then
    let guide = File.ReadAllText llmGuide
    let s = guide.IndexOf startMarker
    let e = guide.IndexOf endMarker
    if s < 0 || e < 0 then failwithf "%s has no catalog markers" llmGuide
    let updated = guide.Substring(0, s) + catalog + guide.Substring(e + endMarker.Length)
    File.WriteAllText(llmGuide, updated, UTF8Encoding(false))
    printfn "catalog written into %s" llmGuide
