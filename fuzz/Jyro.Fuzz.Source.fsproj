<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredCompilation>false</TieredCompilation>
    <!-- Signed with Jyro.snk, the key the shipped assemblies name this friend
         with (Directory.Build.props). -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(JyroKeyFile)</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FuzzHarness.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Jyro.Core\Jyro.Core.fsproj" />
    <ProjectReference Include="..\src\Jyro.Parser\Jyro.Parser.fsproj" />
    <ProjectReference Include="..\src\Jyro.Compiler\Jyro.Compiler.fsproj" />
    <ProjectReference Include="..\src\Jyro.Stdlib\Jyro.Stdlib.fsproj" />
    <ProjectReference Include="..\src\Jyro.Api\Jyro.Api.fsproj" />
  </ItemGroup>


  <Target Name="StageFuzzSeeds" BeforeTargets="Build">
    <ItemGroup>
      <FuzzSeed Include="..\tests\plaintext\**\*.jyro" />
    </ItemGroup>
    <Copy SourceFiles="@(FuzzSeed)" DestinationFolder="$(MSBuildProjectDirectory)\seeds" SkipUnchangedFiles="true" />
  </Target>

</Project>
