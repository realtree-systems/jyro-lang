# AFL++ token dictionary for Jyro source fuzzing.
# Format: one quoted token per line. Hash-prefixed lines are comments.
# Tokens help the mutator synthesise grammar-sensitive inputs.

# Keywords
"var"
"func"
"while"
"for"
"if"
"then"
"else"
"elseif"
"end"
"return"
"exit"
"fail"
"switch"
"match"
"case"
"default"
"union"
"set"
"delete"
"in"
"do"
"break"
"continue"

# Literals
"true"
"false"
"null"

# Boolean operators
"and"
"or"
"not"

# Well-known identifiers
"Input"
"Output"
"Data"

# Comparison / arrow operators
"=="
"!="
"<="
">="
"->"

# Stdlib function names (high-value subset)
"Length"
"Map"
"Where"
"Reduce"
"Find"
"All"
"Any"
"Sort"
"Reverse"
"Append"
"Concatenate"
"Slice"
"RegexTest"
"RegexMatch"
"FromJson"
"ToJson"
"Split"
"Join"
"Substring"
"Base64Decode"
"Base64Encode"
"ToString"
"ToNumber"
"ToBoolean"
"TypeOf"
"Keys"
"Values"
"HasProperty"
"Clone"
"Merge"
"Sleep"
"Sum"
"Average"
"Min"
"Max"
"Round"
"Floor"
"Ceiling"
