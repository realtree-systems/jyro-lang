<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Opts this project into the InternalsVisibleTo block in Directory.Build.props. -->
		<IsJyroAssembly>true</IsJyroAssembly>
		<TargetFramework>net8.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Nullable reference type annotations on the public surface (JYRO-REQ-1931). -->
		<Nullable>enable</Nullable>
		<RootNamespace>RealTree.Jyro</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Position.fs" />
		<Compile Include="Lexer.fs" />
		<Compile Include="SourceScan.fs" />
		<Compile Include="ExpressionParser.fs" />
		<Compile Include="StatementParser.fs" />
		<Compile Include="Parser.fs" />
		<Compile Include="Printer.fs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FParsec" Version="1.1.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Jyro.Core\Jyro.Core.fsproj" />
	</ItemGroup>


</Project>
