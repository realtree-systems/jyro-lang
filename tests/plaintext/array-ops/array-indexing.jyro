# Test array indexing

# Test 1: First element
var arr = [10, 20, 30, 40, 50]
Output.first = arr[0]

# Test 2: Last element
Output.last = arr[4]

# Test 3: Middle element
Output.mid = arr[2]

# Test 4: Out of bounds returns null
Output.oob = arr[99]

# Test 5: Negative index returns null
Output.neg = arr[-1]

# Test 6: Index via variable
var i = 3
Output.varIdx = arr[i]

# Test 7: Nested array access
var nested = [[1, 2], [3, 4], [5, 6]]
Output.nestedAccess = nested[1][0]
Output.nestedDeep = nested[2][1]
