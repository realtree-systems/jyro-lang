# Test short-circuit evaluation of and/or

# Test 1: false and X - X not evaluated
# Use a function call to prove short-circuit (side-effect free approach)
var x = 0
var dummy = false and 99
Output.scAnd = dummy
Output.scAndX = x

# Test 2: true or X - X not evaluated
var y = 0
var dummy2 = true or 99
Output.scOr = dummy2
Output.scOrY = y

# Test 3: true and X - X IS evaluated (returns X)
Output.evalAnd = true and 42

# Test 4: false or X - X IS evaluated (returns X)
Output.evalOr = false or 42
