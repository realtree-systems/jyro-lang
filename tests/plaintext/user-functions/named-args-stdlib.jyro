# Named arguments with stdlib functions

# Reorder args — Substring(text, start, length?)
Output.sub = Substring(start: 2, text: "Hello World")
Output.sub_len = Substring(length: 3, start: 6, text: "Hello World")

# PadLeft(text, length, padding?) — reordered with optional
Output.pad = PadLeft(length: 10, text: "hi", padding: "*")
Output.pad_default = PadLeft(text: "hi", length: 8)

# Replace(source, oldValue, newValue) — fully reordered
Output.replaced = Replace(newValue: "World", oldValue: "X", text: "Hello X")

# Join(values, separator) — a binary function whose parameter names now say
# what they are; they used to be the hardcoded left/right.
Output.joined = Join(separator: " | ", values: ["a", "b", "c"])
