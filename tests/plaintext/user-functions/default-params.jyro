# Default parameter values in user functions
func Greet(name, greeting = "Hello")
    return greeting & ", " & name
end

func TypedGreet(name: string, greeting: string = "Hello", excited: boolean = false)
    var msg = greeting & ", " & name
    if excited then
        msg = msg & "!"
    end
    return msg
end

# All args provided
Output.full = Greet("Alice", "Hi")

# Default used
Output.defaulted = Greet("Bob")

# Typed - all args
Output.typed_full = TypedGreet("Alice", "Hey", true)

# Typed - skip last optional
Output.typed_partial = TypedGreet("Bob", "Yo")

# Typed - all defaults
Output.typed_default = TypedGreet("Charlie")

# Null triggers default
Output.null_default = Greet("Dave", null)
