# Test string comparison operators

# Test 1: Equality
Output.eq = "hello" == "hello"
Output.neq = "hello" != "world"

# Test 2: Less than (alphabetical)
Output.lt = "apple" < "banana"
Output.ltFalse = "banana" < "apple"

# Test 3: Greater than
Output.gt = "banana" > "apple"

# Test 4: Case sensitivity
Output.caseLt = "A" < "a"

# Test 5: Empty string comparisons
Output.emptyLt = "" < "a"
Output.emptyEq = "" == ""

# Test 6: Same prefix
Output.prefixLt = "app" < "apple"
