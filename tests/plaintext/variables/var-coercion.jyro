# Test type coercion via type hints

# Test 1: String to number
var x: number = "42"
Output.strToNum = x

# Test 2: Boolean true to number (1)
var y: number = true
Output.boolToNum = y

# Test 3: Boolean false to number (0)
var z: number = false
Output.falseToNum = z

# Test 4: Number to string
var s: string = 42
Output.numToStr = s

# Test 5: Boolean to string
var bs: string = true
Output.boolToStr = bs
