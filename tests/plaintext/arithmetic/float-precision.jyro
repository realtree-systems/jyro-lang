# Test floating-point precision edge cases

# Test 1: Classic 0.1 + 0.2 (should be ~0.3)
Output.classic = 0.1 + 0.2

# Test 2: Subtraction precision
Output.subPrec = 1.0 - 0.9

# Test 3: Large number arithmetic
Output.large = 1000000 * 1000000

# Test 4: Negative times negative
Output.negNeg = -5 * -3

# Test 5: Small decimal multiplication
Output.smallMul = 0.1 * 0.1

# Test 6: Mixed integer and decimal
Output.mixAdd = 10 + 0.5
