# Test operator precedence

# Test 1: Multiplication before addition
Output.mulFirst = 2 + 3 * 4

# Test 2: Division before subtraction
Output.divFirst = 10 - 6 / 2

# Test 3: Parentheses override
Output.parens = (2 + 3) * 4

# Test 4: Nested parentheses
Output.nested = ((2 + 3) * (4 - 1))

# Test 5: Mixed precedence
Output.mixed = 2 * 3 + 4 * 5

# Test 6: Modulo precedence (same as mul/div)
Output.modPrec = 10 + 7 % 3

# Test 7: Left-to-right associativity
Output.leftAssoc = 20 - 5 - 3 - 2
