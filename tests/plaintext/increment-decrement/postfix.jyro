# Test postfix increment and decrement

# Test 1: Postfix increment returns old value
var a = 10
Output.postInc = a++
Output.afterInc = a

# Test 2: Postfix decrement returns old value
var b = 10
Output.postDec = b--
Output.afterDec = b

# Test 3: Multiple postfix operations
var c = 5
c++
c++
c++
Output.multiInc = c
