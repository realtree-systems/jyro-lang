# Test string escape sequences

# Test 1: Tab
Output.tab = "a\tb"

# Test 2: Newline
Output.newline = "line1\nline2"

# Test 3: Carriage return
Output.cr = "a\rb"

# Test 4: Backslash
Output.backslash = "path\\file"

# Test 5: Escaped double quote
Output.dquote = "say \"hi\""

# Test 6: Escaped single quote in single-quoted string
Output.squote = 'it\'s'

# Test 7: Null char (just test Length is 3)
var s = "a\0b"
Output.nullCharLen = Length(s)

# Test 8: Unicode escape
Output.unicode = "\u0041\u0042\u0043"
