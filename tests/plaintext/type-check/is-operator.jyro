# Test type checking with is operator

# Test 1: Number
Output.numIsNum = 42 is number
Output.numIsStr = 42 is string
Output.numIsBool = 42 is boolean

# Test 2: String
Output.strIsStr = "hello" is string
Output.strIsNum = "hello" is number

# Test 3: Boolean
Output.boolIsBool = true is boolean
Output.boolIsStr = true is string

# Test 4: Null
Output.nullIsNull = null is null
Output.nullIsNum = null is number
Output.nullIsStr = null is string

# Test 5: Array
Output.arrIsArr = [1, 2] is array
Output.arrIsObj = [1, 2] is object

# Test 6: Object
Output.objIsObj = {a: 1} is object
Output.objIsArr = {a: 1} is array
