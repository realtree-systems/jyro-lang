# Test nested if statements

# Test 1: Nested true-true
var a = true
var b = true
Output.nested1 = "none"
if a then
    if b then
        Output.nested1 = "both"
    end
end

# Test 2: Nested true-false
var c = true
var d = false
Output.nested2 = "none"
if c then
    if d then
        Output.nested2 = "both"
    else
        Output.nested2 = "outer-only"
    end
end

# Test 3: Three levels deep
var x = 10
Output.nested3 = "none"
if x > 0 then
    if x > 5 then
        if x > 8 then
            Output.nested3 = "deep"
        end
    end
end

# Test 4: If inside else
var y = 3
if y > 10 then
    Output.nested4 = "big"
else
    if y > 1 then
        Output.nested4 = "medium"
    else
        Output.nested4 = "small"
    end
end
