# Test simple if statement

# Test 1: True condition executes body
Output.result1 = "before"
if true then
    Output.result1 = "inside"
end

# Test 2: False condition skips body
Output.result2 = "before"
if false then
    Output.result2 = "inside"
end

# Test 3: Expression condition
Output.result3 = "none"
if 10 > 5 then
    Output.result3 = "matched"
end

# Test 4: Falsy number condition
Output.result4 = "default"
if 0 then
    Output.result4 = "never"
end
