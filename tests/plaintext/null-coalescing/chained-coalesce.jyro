# Test chained null coalescing

# Test 1: First non-null wins
Output.chain1 = null ?? null ?? "found"

# Test 2: First value is non-null
Output.chain2 = "first" ?? "second" ?? "third"

# Test 3: Middle value
Output.chain3 = null ?? "middle" ?? "last"

# Test 4: All null
Output.allNull = null ?? null ?? null

# Test 5: With variables
var a = null
var b = null
var c = "fallback"
Output.vars = a ?? b ?? c
