<Project Sdk="Microsoft.NET.Sdk">

	<!-- jyro-spec verification of 10.6.1 (JYRO-REQ-9) on a host platform that
	     carries another version of Unicode than 15.0.0. This assembly loads
	     ICU 68.2 (Unicode 13.0) app-locally instead of the operating system's
	     ICU, so a case mapping read from the host, not from the Unicode 15.0.0
	     data, gives a different result here and the test can fail on the build
	     host (JYRO-ADR-143 item 5; the process rule of JYRO-DEF-578). Tests come
	     from the book and the public host API alone (FLOORS 4.1.1). -->

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>RealTree.Jyro.Spec.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<GenerateProgramFile>true</GenerateProgramFile>
	</PropertyGroup>

	<ItemGroup>
		<RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="68.2.0.9" />
	</ItemGroup>

	<ItemGroup>
		<!-- F# compiles in this order. Add each new file here. -->
		<Compile Include="S10_06_HostUnicode.fs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="68.2.0.9" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Jyro.Spec.Common\Jyro.Spec.Common.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Core\Jyro.Core.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Parser\Jyro.Parser.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Compiler\Jyro.Compiler.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Stdlib\Jyro.Stdlib.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Api\Jyro.Api.fsproj" />
	</ItemGroup>

</Project>
