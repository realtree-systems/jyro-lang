<Project Sdk="Microsoft.NET.Sdk">

	<!-- jyro-spec verification, chapters 00, 10, 20. Tests come from the book and
	     the public host API alone (FLOORS 4.1.1). Helpers: ../Jyro.Spec.Common/README.md -->

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>RealTree.Jyro.Spec.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<GenerateProgramFile>true</GenerateProgramFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- F# compiles in this order. Add each new file here. -->
		<Compile Include="Support.fs" />
		<Compile Include="..\Jyro.Spec.Tests.P100_170\ArtifactCodec.fs" Link="ArtifactCodec.fs" />
		<Compile Include="S10_06_Unicode15.fs" />
		<Compile Include="S20_01_Grammar.fs" />
		<Compile Include="S20_01_MatchStatement.fs" />
		<Compile Include="S20_01_LineEnds.fs" />
		<Compile Include="S20_01_StaleDefects.fs" />
		<Compile Include="S20_02_SourceEncoding.fs" />
		<Compile Include="S20_03_Identifiers.fs" />
		<Compile Include="S20_04_Keywords.fs" />
		<Compile Include="S20_05_Comments.fs" />
		<Compile Include="S20_06_Numbers.fs" />
		<Compile Include="S20_07_Strings.fs" />
		<Compile Include="S20_08_Literals.fs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Jyro.Spec.Common\Jyro.Spec.Common.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Core\Jyro.Core.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Parser\Jyro.Parser.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Compiler\Jyro.Compiler.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Stdlib\Jyro.Stdlib.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Api\Jyro.Api.fsproj" />
	</ItemGroup>

</Project>
