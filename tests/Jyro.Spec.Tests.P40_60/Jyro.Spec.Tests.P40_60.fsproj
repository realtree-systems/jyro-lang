<Project Sdk="Microsoft.NET.Sdk">

	<!-- jyro-spec verification, chapters 40, 50, 60. Tests come from the book and
	     the public host API alone (FLOORS 4.1.1). Helpers: ../Jyro.Spec.Common/README.md -->

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>RealTree.Jyro.Spec.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<GenerateProgramFile>true</GenerateProgramFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- F# compiles in this order. Add each new file here. -->
		<Compile Include="Support.fs" />
		<Compile Include="S40_01_Precedence.fs" />
		<Compile Include="S40_02_Arithmetic.fs" />
		<Compile Include="S40_04_Concatenation.fs" />
		<Compile Include="S40_05_Logical.fs" />
		<Compile Include="S40_07_Assignment.fs" />
		<Compile Include="S40_10_Lambdas.fs" />
		<Compile Include="S50_01_Declarations.fs" />
		<Compile Include="S50_01_ShadowedHints.fs" />
		<Compile Include="S50_03_Control.fs" />
		<Compile Include="S50_08_SwitchMatch.fs" />
		<Compile Include="S50_09_10_RepeatedNames.fs" />
		<Compile Include="S50_09_10_RejectedYetValidated.fs" />
		<Compile Include="S50_09_10_LibraryUnions.fs" />
		<Compile Include="S50_11_ExitFailDelete.fs" />
		<Compile Include="S60_Scope.fs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Jyro.Spec.Common\Jyro.Spec.Common.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Core\Jyro.Core.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Parser\Jyro.Parser.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Compiler\Jyro.Compiler.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Stdlib\Jyro.Stdlib.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Api\Jyro.Api.fsproj" />
	</ItemGroup>

</Project>
