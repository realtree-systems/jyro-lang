<Project Sdk="Microsoft.NET.Sdk">

	<!-- jyro-spec verification, chapters 95, 96. Tests come from the book and
	     the public host API alone (FLOORS 4.1.1). Helpers: ../Jyro.Spec.Common/README.md -->

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>RealTree.Jyro.Spec.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<GenerateProgramFile>false</GenerateProgramFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- F# compiles in this order. Add each new file here. -->
		<Compile Include="Util.fs" />
		<Compile Include="S95_01_04_TypeCoalesceToStringToBoolean.fs" />
		<Compile Include="S95_05_09_KeysValuesHasPropertyMergeClone.fs" />
		<Compile Include="S95_10_12_NewGuidBase64.fs" />
		<Compile Include="S95_13_14_FromJsonToJson.fs" />
		<Compile Include="S95_15_16_SleepDiff.fs" />
		<Compile Include="S96_01_ValidateRequired.fs" />
		<Compile Include="S96_02a_ValidateSchema.fs" />
		<Compile Include="S96_02b_ValidateSchema.fs" />
		<Compile Include="S96_02c_ValidateSchemaPositions.fs" />
		<Compile Include="Program.fs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Jyro.Spec.Common\Jyro.Spec.Common.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Core\Jyro.Core.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Parser\Jyro.Parser.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Compiler\Jyro.Compiler.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Stdlib\Jyro.Stdlib.fsproj" />
		<ProjectReference Include="..\..\src\Jyro.Api\Jyro.Api.fsproj" />
	</ItemGroup>

</Project>
